# Dependencies
node_modules/

# Runtime state
#
# data/workspaces.json and data/watchlists.json are deliberately tracked. On a
# host without a persistent disk (Render's free plan, for one) the container
# filesystem is wiped on every deploy, and these two files are what the app
# boots from — without them a deploy comes up as the bare default board. Attach
# a disk and set DATA_DIR if you would rather keep them out of git.
data/*.tmp
data/server.log
data/server.err
*.log

# Secrets — nothing in this project needs one, but keep them out if that changes
.env
.env.*
!.env.example

# Python (the fundamentals sidecar is a script, not an import, but be safe)
__pycache__/
*.py[cod]

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local overrides
*.local
data/*.jsonl
# The daily copies the job keeps are the repository's copy of the series, so
# they are tracked; the live file in the container is not.
!data/history/*.jsonl
# The measured rule edges are a cache: the app rebuilds them in the background
# and they change every time the test is run.
data/rule-edges.json
